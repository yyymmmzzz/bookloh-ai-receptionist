# =====================================================
# Bookloh AI Receptionist Demo — Environment Variables
# =====================================================
# Copy this file to `.env.local` and fill in real values.

# ----- Supabase (Database + Auth) -----
# Get these from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ^ service_role key bypasses RLS — only use in API routes, never expose to client

# ----- Vapi (Voice AI) -----
# Get these from https://dashboard.vapi.ai → Account → API Keys
VAPI_API_KEY=sk-xxxx
VAPI_ASSISTANT_ID=asst_xxxx
# Public key for client-side test calls (optional, for in-browser testing)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=pk-xxxx

# Multi-region: one assistant per country. Each has its own STT + voice + system prompt.
# Created via scripts/update-vapi-assistant-{sg,my,id}.js
# Leave blank until you've run the corresponding update script.
VAPI_SG_ASSISTANT_ID=
VAPI_MY_ASSISTANT_ID=
VAPI_ID_ASSISTANT_ID=

# ----- ElevenLabs (Voice Clone) -----
# Get these from https://elevenlabs.io → Voices → Your cloned voice
# voiceId is the unique ID of the cloned voice (e.g. "HZrCrY9LUzc3dRxar8U2" for Yimo)
# credentialId is the Vapi credential linking ElevenLabs API key to the assistant
ELEVENLABS_VOICE_ID=HZrCrY9LUzc3dRxar8U2
ELEVENLABS_CREDENTIAL_ID=81f47cad-b6b0-474f-a075-630e559659c4

# ----- OpenAI (Optional: LLM call-summary extraction) -----
# Get from https://platform.openai.com/api-keys
# If unset, call-summary falls back to regex (see src/lib/call-summary.ts).
# ~$0.001 per call (gpt-4o-mini) — 1000 calls ≈ $1.
# Leave blank to disable. LLM extraction is significantly more accurate than regex.
OPENAI_API_KEY=sk-xxxx

# ----- Twilio (Phone Number + SMS) -----
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+17135551234    # The US number Vapi forwards calls from
TWILIO_BOSS_PHONE=+17135559876      # Boss's personal phone for urgent calls

# ----- Google Maps (Address validation + distance) -----
# Get from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=AIzaSyXXXX

# ----- App config -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_SECRET=change-me-to-a-random-string  # Used to verify Vapi webhooks

# ----- Demo boss defaults (used to seed DB) -----
SEED_BOSS_COMPANY=Handy Works Home Services
SEED_BOSS_NAME=Alex
SEED_BOSS_PHONE=+17135559876
SEED_BOSS_BASE_ZIP=77002
SEED_BOSS_RADIUS_MILES=25
SEED_DIAGNOSTIC_FEE=89
