{
  "name": "H-Master Bintulu Receptionist",
  "model": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "temperature": 0.2,
    "maxTokens": 80
  },
  "voice": {
    "provider": "11labs",
    "voiceId": "HZrCrY9LUzc3dRxar8U2",
    "model": "eleven_flash_v2_5",
    "stability": 0.5,
    "similarityBoost": 0.75,
    "useSpeakerBoost": true
  },
  "firstMessage": "H-Master security, Bintulu. How can I help.",
  "endCallFunctionEnabled": true,
  "endCallPhrases": ["bye", "goodbye", "thanks bye"],
  "silenceTimeoutSeconds": 20,
  "responseDelaySeconds": 0.3,
  "llmRequestDelaySeconds": 0.3,
  "interruptionThreshold": 500,
  "maxDurationSeconds": 600,
  "serverUrl": "https://demo-navy-chi-47.vercel.app/api/vapi/tools",
  "serverUrlSecret": "<<SAME VALUE AS WEBHOOK_SECRET IN YOUR .env>>",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "end_call",
        "description": "End the call. Placeholder assistant — always transfer to human.",
        "parameters": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": ["accepted", "urgent", "unsure", "rejected"],
              "description": "Always use 'unsure' for placeholder — routes to human"
            },
            "summary": {
              "type": "string",
              "description": "Brief summary of what caller wanted"
            }
          },
          "required": ["outcome", "summary"]
        }
      }
    }
  ]
}
